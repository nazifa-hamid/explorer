# --model glm (default) — free key from z.ai: profile menu → API Keys
ZAI_API_KEY=
GLM_MODEL=glm-4.7-flash

# --model local — Gemma 4 via llama-server.
# Start it with --jinja, or tool calls arrive as prose and the loop never fires:
#   llama-server --model <path>.gguf --host 127.0.0.1 --port 8080 \
#     --n-gpu-layers 99 --ctx-size 32768 --parallel 1 --jinja
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_MODEL=gemma-4-e4b

# --model gemini — free key from aistudio.google.com
# Pin a specific model; do not use a "-latest" alias and do not guess an ID.
#   - aliases resolve to the newest model, which has the smallest free quota
#     (gemini-flash-latest resolved to one capped at 20 requests/day — one run)
#   - IDs are not derivable: gemini-3-flash 404s, gemini-3.6-flash is real
#   - older IDs get withdrawn: gemini-2.5-flash now 404s for new keys
# Run `run-explorer models` to list what your key can actually use, and pick one
# generation behind the newest. Limits: https://ai.google.dev/gemini-api/docs/rate-limits
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Search engines, tried in order. ddgs fronts scrapers rather than official APIs, so
# any one can fail on a given day — the chain is what makes it dependable.
# Options: google, brave, duckduckgo, startpage, mojeek, yahoo, yandex, wikipedia
SEARCH_BACKEND=google, brave, duckduckgo
